{% extends "admin/layout.twig" %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Transações</h2>
        <div class="card-actions">
            <span class="badge">{{ transacoes|length }} transações</span>
        </div>
    </div>
    <div class="card-body">
        {% if transacoes|length > 0 %}
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID Transação</th>
                        <th>Usuário</th>
                        <th>Status</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for transacao in transacoes %}
                    <tr>
                        <td>
                            <span class="text-mono">{{ transacao.transaction_id|slice(0, 16) }}...</span>
                        </td>
                        <td>
                            {% if transacao.username %}
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <img src="{{ transacao.profile_pic_url|default('/images/avatars/perfil-sem-foto.jpeg') }}" 
                                         alt="{{ transacao.username }}" 
                                         style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                                    <div>
                                        <div style="font-weight: 600;">{{ transacao.full_name|default(transacao.username) }}</div>
                                        <div class="text-muted" style="font-size: 11px;">@{{ transacao.username }}</div>
                                    </div>
                                </div>
                            {% else %}
                                <span class="text-muted">Usuário não identificado</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if transacao.status == 'paid' %}
                                <span class="badge badge-success">Pago</span>
                            {% elseif transacao.status == 'pending' %}
                                <span class="badge badge-warning">Pendente</span>
                            {% elseif transacao.status == 'expired' %}
                                <span class="badge badge-danger">Expirado</span>
                            {% else %}
                                <span class="badge badge-secondary">{{ transacao.status }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <strong>R$ {{ transacao.amount|number_format(2, ',', '.') }}</strong>
                        </td>
                        <td>
                            <span class="text-muted">{{ transacao.created_at|date('d/m/Y H:i') }}</span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-secondary" onclick="verDetalhes('{{ transacao.transaction_id }}')">
                                <svg width="14" height="14"><use href="#icon-eye"/></svg>
                                Ver
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="empty-state">
            <svg width="48" height="48" style="opacity: 0.3;"><use href="#icon-credit-card"/></svg>
            <p>Nenhuma transação encontrada</p>
        </div>
        {% endif %}
    </div>
</div>

<style>
.table-responsive {
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table thead {
    background: var(--bg-secondary);
}

.data-table th {
    padding: 12px 16px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--border-color);
}

.data-table td {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
}

.data-table tbody tr:hover {
    background: var(--bg-secondary);
}

.text-mono {
    font-family: 'Courier New', monospace;
    font-size: 12px;
}

.text-primary {
    color: var(--primary-color);
}

.text-muted {
    color: var(--text-tertiary);
}

.badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-success {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
}

.badge-warning {
    background: rgba(251, 191, 36, 0.1);
    color: #fbbf24;
}

.badge-danger {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
}

.badge-secondary {
    background: var(--bg-secondary);
    color: var(--text-secondary);
}

.btn-sm {
    padding: 6px 12px;
    font-size: 12px;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-tertiary);
}

.empty-state svg {
    margin-bottom: 16px;
}

.empty-state p {
    font-size: 14px;
    margin: 0;
}
</style>

<script>
function verDetalhes(transactionId) {
    alert('Detalhes da transação: ' + transactionId);
    // Implementar modal ou página de detalhes
}
</script>
{% endblock %}

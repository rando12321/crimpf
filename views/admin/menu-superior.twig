<header class="header">
    <div class="header-left">
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
            <svg><use href="#icon-menu"/></svg>
        </button>
        <h1 class="page-title">{{ pageTitle|default('Admin Panel') }}</h1>
    </div>

    <div class="header-right">
        <button class="theme-toggle" id="themeToggle" aria-label="Alternar tema">
            <svg id="themeIcon"><use href="#icon-moon"/></svg>
        </button>

        <div class="user-menu">
            <div class="user-avatar">{{ user.initials|default('A') }}</div>
            <div class="user-info">
                <div class="user-name">{{ user.name|default('Administrador') }}</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </div>
</header>

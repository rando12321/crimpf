<script>
// TIMER (não inicia automaticamente)
let s = 14*60+59;
let timerInterval = null;

function startTimer(){
  if(timerInterval) clearInterval(timerInterval);
  s = 14*60+59;
  const tEl = document.getElementById('modalTmr');
  timerInterval = setInterval(()=>{
    if(s<=0){
      clearInterval(timerInterval);
      tEl.textContent='Expirado';
      tEl.style.color='var(--red)';
      return;
    }
    s--;
    tEl.textContent = `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;
  },1000);
}

// MODAL
function openPixModal(){
  document.getElementById('pixModal').style.display='flex';
  document.body.style.overflow='hidden';
  startTimer();
}

function closePixModal(){
  document.getElementById('pixModal').style.display='none';
  document.body.style.overflow='';
  if(timerInterval) clearInterval(timerInterval);
}

// COPY MODAL
function doCopyModal(){
  const v = document.getElementById('modalPixVal').value;
  
  if(!v || v === '' || v === 'Aguardando código...'){
    toast('Código Pix ainda não disponível');
    return;
  }
  
  navigator.clipboard.writeText(v).catch(()=>{
    const el=document.getElementById('modalPixVal');el.select();document.execCommand('copy');
  });
  const btn=document.getElementById('modalCpBtn');
  const txt=document.getElementById('modalCpTxt');
  txt.textContent='Copiado!';
  btn.style.background='var(--ok)';
  setTimeout(()=>{txt.textContent='Copiar código';btn.style.background=''},2200);
  toast('Código Pix copiado com sucesso');
}

// COPY
function doCopy(){
  const v = document.getElementById('pixVal').value;
  navigator.clipboard.writeText(v).catch(()=>{

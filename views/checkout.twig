<!-- Product Config Script -->
<script>
// Buscar configurações do produto
let productConfig = {
  product_name: 'Método Completo de Marketing Digital',
  product_price_original: '497.00',
  product_price_final: '197.00',
  product_discount_percent: '60'
};

// Carregar configurações quando a página carregar
document.addEventListener('DOMContentLoaded', function() {
  fetch('/api/product-config.php')
    .then(res => res.json())
    .then(config => {
      productConfig = config;
      updateProductInfo();
    })
    .catch(err => console.error('Erro ao carregar config do produto:', err));
});

function updateProductInfo() {
  // Atualizar nome do produto
  const productNameElements = document.querySelectorAll('.product-name');
  productNameElements.forEach(el => el.textContent = productConfig.product_name);
  
  // Atualizar preços
  const priceOriginal = parseFloat(productConfig.product_price_original);
  const priceFinal = parseFloat(productConfig.product_price_final);
  const discount = productConfig.product_discount_percent;
  
  // Preço original (riscado)
  document.querySelectorAll('.price-was').forEach(el => {
    el.textContent = `R$ ${priceOriginal.toFixed(2).replace('.', ',')}`;
  });
  
  // Preço final
  const priceInt = Math.floor(priceFinal);
  const priceCents = Math.round((priceFinal - priceInt) * 100);
  document.querySelectorAll('.price-now').forEach(el => {
    el.innerHTML = `<sup>R$&thinsp;</sup>${priceInt}<small style="font-size:15px;font-weight:600">,${priceCents.toString().padStart(2, '0')}</small>`;
  });
  
  // Badge de desconto
  document.querySelectorAll('.badge-off').forEach(el => {
    el.textContent = `${discount}% off`;
  });
  
  // Valores no resumo
  document.querySelectorAll('.sum-product-price').forEach(el => {
    el.textContent = `R$ ${priceOriginal.toFixed(2).replace('.', ',')}`;
  });
  
  document.querySelectorAll('.sum-discount').forEach(el => {
    const discountValue = priceOriginal - priceFinal;
    el.textContent = `− R$ ${discountValue.toFixed(2).replace('.', ',')}`;
  });
  
  document.querySelectorAll('.sum-total, .sum-pix-total').forEach(el => {
    el.textContent = `R$ ${priceFinal.toFixed(2).replace('.', ',')}`;
  });
  
  // Valor nas instruções
  document.querySelectorAll('.step-value').forEach(el => {
    el.innerHTML = `<b>R$ ${priceFinal.toFixed(2).replace('.', ',')}</b>`;
  });
}
</script>


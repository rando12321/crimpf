// EMAIL
function chkEmail(el){
  const ok=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value);
  el.classList.toggle('err',el.value.length>4&&!ok);
  el.classList.toggle('ok-field',el.value.length>4&&ok);
}

// CPF
function fmtCPF(el){
  let v=el.value.replace(/\D/g,'').substring(0,11);
  if(v.length>9)v=v.replace(/(\d{3})(\d{3})(\d{3})(\d{0,2})/,'$1.$2.$3-$4');
  else if(v.length>6)v=v.replace(/(\d{3})(\d{3})(\d{0,3})/,'$1.$2.$3');
  else if(v.length>3)v=v.replace(/(\d{3})(\d{0,3})/,'$1.$2');
  el.value=v;
}

// PHONE
function fmtTel(el){
  let v=el.value.replace(/\D/g,'').substring(0,11);
  if(v.length>6)v=v.replace(/(\d{2})(\d{5})(\d{0,4})/,'($1) $2-$3');
  else if(v.length>2)v=v.replace(/(\d{2})(\d{0,5})/,'($1) $2');
  el.value=v;
}

// SUBMIT
function doSubmit(){
  // Validar campos
  const name = document.querySelector('input[type="text"]').value;
  const email = document.getElementById('em').value;
  const email2 = document.getElementById('em2').value;
  const cpf = document.querySelectorAll('input[type="text"]')[1].value;
  const phone = document.querySelectorAll('input[type="text"]')[2].value;

  if(!name || !email || !email2 || !cpf || !phone){
    toast('Por favor, preencha todos os campos');
    return;
  }

  if(email !== email2){
    toast('Os e-mails não coincidem');
    return;
  }

  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    toast('E-mail inválido');
    return;
  }

  const btn=document.getElementById('cta');
  const ic=document.getElementById('ctaIcon');
  const tx=document.getElementById('ctaTxt');
  const sp=document.getElementById('ctaSpin');
  
  btn.disabled=true;btn.style.opacity='.8';
  ic.style.display='none';sp.style.display='block';
  tx.textContent='Gerando pagamento…';

  // Fazer requisição para criar pagamento
  fetch('/api/payment/create', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
      name: name,
      email: email,
      cpf: cpf,
      phone: phone,
      amount: 197.00
    })
  })
  .then(res => res.json())
  .then(data => {
    console.log('Resposta da API:', data);
    
    if(data.success){
      // Atualizar Copia e Cola no modal
      if(data.copia_cola){
        document.getElementById('modalPixVal').value = data.copia_cola;
        console.log('Copia e Cola:', data.copia_cola);
      } else {
        console.warn('Copia e Cola não encontrado na resposta');
      }
      
      // Gerar QR Code a partir do código Pix (com delay para garantir que a biblioteca carregou)
      if(data.qr_code){
        setTimeout(() => {
          const qrBox = document.getElementById('modalQrBox');
          qrBox.innerHTML = ''; // Limpar conteúdo
          
          // Verificar se QRCode está disponível
          if (typeof QRCode === 'undefined') {
            console.error('Biblioteca QRCode não carregada');
            qrBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--red);font-size:12px;text-align:center;padding:20px">Erro: Biblioteca QR Code não carregada. Tente recarregar a página.</div>';
            return;
          }
          
          console.log('Gerando QR Code com código Pix...');
          
          try {
            // Usar QRCodeJS (biblioteca alternativa)
            new QRCode(qrBox, {
              text: data.qr_code,
              width: 164,
              height: 164,
              colorDark: '#0D1117',
              colorLight: '#FFFFFF',
              correctLevel: QRCode.CorrectLevel.M
            });
            console.log('QR Code gerado com sucesso!');
          } catch (error) {
            console.error('Erro ao gerar QR Code:', error);
            qrBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--red);font-size:12px;text-align:center;padding:20px">Erro ao gerar QR Code: ' + error.message + '</div>';
          }
        }, 300); // Aguardar 300ms para garantir que a biblioteca carregou
      } else {
        console.warn('QR Code não encontrado na resposta');
      }
      
      btn.disabled=false;btn.style.opacity='1';
      ic.style.display='';sp.style.display='none';
      tx.textContent='Gerar pagamento Pix';
      
      // Abrir modal
      openPixModal();
      toast('Pagamento gerado com sucesso!');
      
      // Iniciar polling para verificar status
      checkPaymentStatus(data.transaction_id);
    } else {
      throw new Error(data.error || 'Erro ao gerar pagamento');
    }
  })
  .catch(err => {
    btn.disabled=false;btn.style.opacity='1';
    ic.style.display='';sp.style.display='none';
    tx.textContent='Gerar pagamento Pix';
    toast('Erro: ' + err.message);
  });
}

// Verificar status do pagamento
function checkPaymentStatus(transactionId){
  const interval = setInterval(() => {
    fetch('/api/payment/status?transaction_id=' + transactionId)
      .then(res => res.json())
      .then(data => {
        if(data.status === 'paid'){
          clearInterval(interval);
          closePixModal();
          toast('Pagamento confirmado! Redirecionando...');
          setTimeout(() => {
            window.location.href = '/obrigado';
          }, 2000);
        }
      })
      .catch(err => console.error('Erro ao verificar status:', err));
  }, 5000); // Verificar a cada 5 segundos
}

// TOAST
function toast(msg){
  const t=document.getElementById('toast');
  document.getElementById('toastMsg').textContent=msg;
  t.classList.add('on');
  setTimeout(()=>t.classList.remove('on'),3200);
}
</script>


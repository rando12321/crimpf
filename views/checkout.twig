<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout Seguro · PerfectPay</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --pix:#32BCAD;
  --pix-2:#149E8F;
  --pix-bg:#F0FDFB;
  --pix-border:#99E6DF;
  --ok:#16A34A;
  --ok-bg:#F0FDF4;
  --ok-border:#BBF7D0;
  --ink:#0D1117;
  --ink-2:#3D4450;
  --ink-3:#6B7280;
  --ink-4:#9CA3AF;
  --line:#E5E7EB;
  --surface:#F8F9FA;
  --white:#FFFFFF;
  --red:#DC2626;
  --shadow-sm:0 1px 2px rgba(0,0,0,.06);
  --shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
  --shadow-md:0 4px 16px rgba(0,0,0,.08);
  --r:10px;
  --r-sm:7px;
}

html{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
body{font-family:'DM Sans',sans-serif;background:#EDEEF0;color:var(--ink);font-size:14px;line-height:1.5;min-height:100vh}

/* ─ NAV ─ */
nav{
  background:var(--white);
  border-bottom:1px solid var(--line);
  height:52px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 20px;
}
.nav-logo{display:flex;align-items:center;gap:7px;text-decoration:none}
.nav-logo-mark{
  width:28px;height:28px;background:var(--ink);border-radius:7px;
  display:flex;align-items:center;justify-content:center;flex-shrink:0
}
.nav-logo-text{font-size:14px;font-weight:700;color:var(--ink);letter-spacing:-.3px}
.nav-logo-text span{color:var(--pix)}
.nav-secure{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:500;color:var(--ink-3)}

/* ─ LAYOUT ─ */
.wrap{max-width:460px;margin:0 auto;padding:20px 14px 64px}

/* ─ CARD ─ */
.block{
  background:var(--white);
  border-radius:var(--r);
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  overflow:hidden;
  margin-bottom:10px;
}

/* ─ PRODUCT ─ */
.product-top{
  padding:18px;
  border-bottom:1px solid var(--line);
  display:flex;
  gap:13px;
  align-items:flex-start;
}
.thumb{
  width:58px;height:58px;flex-shrink:0;
  border-radius:9px;
  background:linear-gradient(140deg,#1E293B,#0F172A);
  display:flex;align-items:center;justify-content:center;
  border:1px solid rgba(255,255,255,.06);
  box-shadow:0 2px 8px rgba(0,0,0,.18);
}
.product-name{font-size:14px;font-weight:600;color:var(--ink);line-height:1.35;margin-bottom:3px}
.product-by{font-size:12px;color:var(--ink-4);display:flex;align-items:center;gap:4px}

.price-row{
  padding:14px 18px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--line);
}
.price-left{display:flex;align-items:baseline;gap:8px}
.price-was{font-size:12px;color:var(--ink-4);text-decoration:line-through;font-weight:400}
.price-now{font-size:22px;font-weight:700;color:var(--ink);letter-spacing:-.5px;line-height:1}
.price-now sup{font-size:13px;font-weight:600;vertical-align:super;letter-spacing:0}
.badge-off{
  font-size:10px;font-weight:700;
  background:#FEF3C7;color:#92400E;
  border-radius:4px;padding:2px 7px;
  letter-spacing:.3px;text-transform:uppercase
}

/* ─ SECTION HEADER ─ */
.sec-head{
  padding:12px 18px;
  font-size:11px;font-weight:600;
  color:var(--ink-3);letter-spacing:.6px;text-transform:uppercase;
  background:var(--surface);
  border-bottom:1px solid var(--line);
  display:flex;align-items:center;gap:7px
}

/* ─ FORM ─ */
.form-body{padding:16px 18px}
.fg{display:flex;flex-direction:column;gap:4px;flex:1}
.fg label{font-size:11px;font-weight:600;color:var(--ink-3);letter-spacing:.2px}
.fg input{
  border:1.5px solid var(--line);
  border-radius:var(--r-sm);
  padding:9px 11px;
  font-size:13px;
  font-family:'DM Sans',sans-serif;
  color:var(--ink);
  background:var(--white);
  outline:none;
  transition:border-color .15s,box-shadow .15s;
  width:100%
}
.fg input::placeholder{color:var(--ink-4);font-size:12.5px}
.fg input:focus{border-color:var(--pix);box-shadow:0 0 0 3px rgba(50,188,173,.13)}
.fg input.err{border-color:var(--red);box-shadow:0 0 0 3px rgba(220,38,38,.1)}
.fg input.ok-field{border-color:var(--ok)}
.fr{display:flex;gap:10px;margin-bottom:10px}
.fr:last-child{margin-bottom:0}

/* ─ PIX BLOCK ─ */
.pix-hero{
  padding:20px 18px 16px;
  display:flex;flex-direction:column;align-items:center;
  border-bottom:1px solid var(--line);
}

.pix-logo-wrap{
  display:flex;align-items:center;gap:9px;
  background:var(--pix-bg);
  border:1px solid var(--pix-border);
  border-radius:8px;
  padding:10px 16px;
  width:100%;
  margin-bottom:18px;
}
.pix-logo-label{font-size:13px;font-weight:600;color:var(--pix-2)}
.pix-logo-sub{font-size:11px;color:var(--pix);margin-top:1px}

/* QR */
.qr-outer{
  width:164px;height:164px;
  border:1.5px solid var(--line);
  border-radius:12px;
  padding:10px;
  background:var(--white);
  margin-bottom:10px;
  position:relative;
}
.qr-grid{
  width:100%;height:100%;
  display:grid;
  grid-template-columns:repeat(11,1fr);
  grid-template-rows:repeat(11,1fr);
  gap:1.5px;
}
.qr-c{background:var(--ink);border-radius:1px}
.qr-c.w{background:transparent}

/* finder pattern top-left */
.qr-finder{
  position:absolute;
  width:34px;height:34px;
  border:3px solid var(--ink);
  border-radius:4px;
}
.qr-finder.tl{top:10px;left:10px}
.qr-finder.tr{top:10px;right:10px}
.qr-finder.bl{bottom:10px;left:10px}
.qr-finder-inner{
  position:absolute;
  width:14px;height:14px;
  background:var(--ink);
  border-radius:2px;
  top:50%;left:50%;
  transform:translate(-50%,-50%)
}

.qr-center{
  position:absolute;
  inset:0;display:flex;
  align-items:center;justify-content:center;
  pointer-events:none;
}
.qr-center-box{
  background:var(--white);
  border-radius:6px;
  padding:5px;
  box-shadow:0 0 0 1.5px var(--line);
}

.timer-pill{
  display:flex;align-items:center;gap:5px;
  font-size:11px;font-weight:500;color:var(--ink-3);
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:20px;
  padding:4px 11px;
}
.timer-pill .t{font-family:'DM Mono',monospace;font-weight:500;color:var(--pix-2);font-size:12px}

/* COPY */
.copy-wrap{padding:14px 18px;border-bottom:1px solid var(--line)}
.copy-label{font-size:11px;font-weight:600;color:var(--ink-3);letter-spacing:.3px;text-transform:uppercase;margin-bottom:7px}
.copy-row{display:flex;gap:7px}
.copy-input{
  flex:1;
  border:1.5px solid var(--line);
  border-radius:var(--r-sm);
  padding:9px 11px;
  font-size:11px;font-family:'DM Mono',monospace;
  color:var(--ink-3);background:var(--surface);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  cursor:default;outline:none;
}
.copy-btn{
  display:flex;align-items:center;gap:6px;
  padding:9px 14px;
  background:var(--ink);color:var(--white);
  border:none;border-radius:var(--r-sm);
  font-size:12px;font-weight:600;
  font-family:'DM Sans',sans-serif;
  cursor:pointer;white-space:nowrap;
  transition:background .15s,transform .1s;
  letter-spacing:.1px;
}
.copy-btn:hover{background:#1E293B}
.copy-btn:active{transform:scale(.98)}

/* STEPS */
.steps-wrap{padding:14px 18px 16px;border-bottom:1px solid var(--line)}
.step{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px}
.step:last-child{margin-bottom:0}
.step-n{
  width:20px;height:20px;flex-shrink:0;
  background:var(--pix);color:var(--white);
  border-radius:50%;font-size:10px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  margin-top:1px
}
.step-t{font-size:12.5px;color:var(--ink-2);line-height:1.45}
.step-t b{color:var(--ink);font-weight:600}

/* CHIPS */
.chips{display:flex;gap:6px;padding:14px 18px;flex-wrap:wrap}
.chip{
  display:flex;align-items:center;gap:5px;
  border:1px solid var(--ok-border);
  background:var(--ok-bg);
  border-radius:20px;
  padding:4px 10px;
  font-size:11px;font-weight:500;color:var(--ok)
}

/* ─ SUMMARY ─ */
.sum-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:11px 18px;
  font-size:13px;
  border-bottom:1px solid var(--line);
}
.sum-row:last-child{border-bottom:none}
.sum-row .l{color:var(--ink-3)}
.sum-row .r{font-weight:600;color:var(--ink)}
.sum-row.dis .r{color:var(--ok)}
.sum-row.tot{background:var(--surface)}
.sum-row.tot .l{font-weight:700;color:var(--ink);font-size:13.5px}
.sum-row.tot .r{font-weight:800;font-size:16px;color:var(--ink)}
.sum-row.pix-r .l{color:var(--pix-2);font-weight:500;display:flex;align-items:center;gap:6px}
.sum-row.pix-r .r{color:var(--pix-2);font-weight:700}
.sum-row.pix-r{background:var(--pix-bg)}

/* ─ GUARANTEE ─ */
.guarantee{
  display:flex;align-items:center;gap:12px;
  background:var(--ok-bg);
  border:1px solid var(--ok-border);
  border-radius:var(--r);
  padding:13px 15px;
  margin-bottom:10px;
}
.guarantee-icon{flex-shrink:0;color:var(--ok)}
.guarantee-text h4{font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:2px}
.guarantee-text p{font-size:11.5px;color:var(--ink-3);line-height:1.45}

/* ─ CTA ─ */
.cta{
  width:100%;padding:15px;
  background:var(--pix);
  color:var(--white);border:none;
  border-radius:var(--r);
  font-size:14.5px;font-weight:700;
  font-family:'DM Sans',sans-serif;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:9px;
  box-shadow:0 4px 14px rgba(50,188,173,.3),0 1px 3px rgba(50,188,173,.2);
  transition:all .18s;
  margin-bottom:9px;
  letter-spacing:.1px;
  position:relative;overflow:hidden;
}
.cta::after{
  content:'';
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(255,255,255,.08),transparent);
}
.cta:hover{background:var(--pix-2);box-shadow:0 6px 20px rgba(50,188,173,.38);transform:translateY(-1px)}
.cta:active{transform:none;box-shadow:0 2px 8px rgba(50,188,173,.25)}

/* ─ TRUST BAR ─ */
.trust{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:var(--r);
  padding:14px 18px;
  display:flex;justify-content:center;gap:0;
  margin-bottom:10px;
}
.ti{
  display:flex;flex-direction:column;align-items:center;gap:4px;
  flex:1;padding:0 6px;
  border-right:1px solid var(--line);
}
.ti:last-child{border-right:none}
.ti span{font-size:10px;font-weight:500;color:var(--ink-4);text-align:center;line-height:1.3}

/* ─ FOOT ─ */
.foot{text-align:center;font-size:11px;color:var(--ink-4);display:flex;align-items:center;justify-content:center;gap:5px}
.foot strong{color:var(--ink-3);font-weight:600}
.sec-line{text-align:center;font-size:11.5px;color:var(--ink-4);margin-bottom:8px;display:flex;align-items:center;justify-content:center;gap:5px}
.sec-line span{color:var(--ok);font-weight:500}

/* ─ SPINNER ─ */
.spin{display:none;width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:rot .65s linear infinite;flex-shrink:0}
@keyframes rot{to{transform:rotate(360deg)}}

/* ─ TOAST ─ */
.toast{
  position:fixed;bottom:22px;left:50%;
  transform:translateX(-50%) translateY(10px);
  background:var(--ink);color:var(--white);
  padding:10px 18px;border-radius:8px;
  font-size:12.5px;font-weight:500;
  opacity:0;transition:all .22s;z-index:9999;
  display:flex;align-items:center;gap:7px;white-space:nowrap;
  box-shadow:0 4px 20px rgba(0,0,0,.2)
}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}

/* ─ PULSE on QR ─ */
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
.qr-outer.pending .qr-center-box{animation:pulse 2s ease-in-out infinite}

/* QR Code gerado */
#modalQrBox img{
  width:100% !important;
  height:100% !important;
  border-radius:12px;
  object-fit:contain;
}

/* ─ MODAL ─ */
.modal-overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,.75);
  display:flex;align-items:center;justify-content:center;
  z-index:10000;padding:20px;
  backdrop-filter:blur(4px);
  animation:fadeIn .25s ease-out;
}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

.modal-content{
  background:var(--white);
  border-radius:var(--r);
  max-width:460px;width:100%;
  max-height:90vh;overflow-y:auto;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  position:relative;
  animation:slideUp .3s ease-out;
}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

.modal-close{
  position:absolute;top:14px;right:14px;
  width:32px;height:32px;
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;z-index:1;
  transition:all .15s;
}
.modal-close:hover{background:var(--line);transform:scale(1.05)}
.modal-close svg{color:var(--ink-3)}

.modal-header{
  padding:24px 20px 16px;
  border-bottom:1px solid var(--line);
}

.modal-body{
  padding:20px;
  display:flex;flex-direction:column;align-items:center;
}

.modal-body .qr-outer{margin-bottom:12px}
.modal-body .timer-pill{margin-bottom:16px}

.copy-wrap-modal{
  width:100%;
  padding:16px;
  background:var(--surface);
  border-radius:var(--r-sm);
  margin-bottom:16px;
}

.steps-wrap-modal{
  width:100%;
  padding:16px;
  background:var(--surface);
  border-radius:var(--r-sm);
  margin-bottom:12px;
}

.steps-wrap-modal .step{margin-bottom:12px}
.steps-wrap-modal .step:last-child{margin-bottom:0}

@media(max-width:400px){
  .fr{flex-direction:column}
  .trust{gap:0;padding:12px 10px}
  .ti{padding:0 4px}
  .modal-content{max-height:95vh}
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="nav-logo" href="#">
    <div class="nav-logo-mark">
      <!-- PP mark -->
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 13V3h6a5 5 0 0 1 0 10H3z" fill="#32BCAD"/>
        <circle cx="9" cy="8" r="2.2" fill="#0D1117"/>
      </svg>
    </div>
    <span class="nav-logo-text">Perfect<span>Pay</span></span>
  </a>
  <div class="nav-secure">
    <!-- lock -->
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
    Ambiente seguro
  </div>
</nav>

<div class="wrap">

  <!-- PRODUCT -->
  <div class="block">
    <div class="product-top">
      <div class="thumb">
        <!-- abstract product icon -->
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <rect x="4" y="8" width="20" height="14" rx="3" fill="#32BCAD" opacity=".9"/>
          <rect x="9" y="4" width="10" height="7" rx="2" fill="#5EEAD4"/>
          <path d="M10 15h8M10 18h5" stroke="#0D1117" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="product-name">Método Completo de Marketing Digital</div>
        <div class="product-by">
          <!-- user icon -->
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          João Silva &middot; Produtor Digital
        </div>
      </div>
    </div>
    <div class="price-row">
      <div class="price-left">
        <span class="price-was">R$ 497,00</span>
        <span class="price-now"><sup>R$&thinsp;</sup>197<small style="font-size:15px;font-weight:600">,00</small></span>
      </div>
      <span class="badge-off">60% off</span>
    </div>
  </div>

  <!-- PERSONAL DATA -->
  <div class="block">
    <div class="sec-head">
      <!-- id-card icon -->
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="5" width="20" height="14" rx="2"/>
        <circle cx="8.5" cy="11" r="2.5"/>
        <path d="M14 9h4M14 13h3"/>
      </svg>
      Seus dados
    </div>
    <div class="form-body">
      <div class="fr">
        <div class="fg">
          <label>Nome completo *</label>
          <input type="text" placeholder="Como está no seu documento">
        </div>
      </div>
      <div class="fr">
        <div class="fg">
          <label>E-mail *</label>
          <input type="email" id="em" placeholder="seuemail@exemplo.com" oninput="chkEmail(this)">
        </div>
      </div>
      <div class="fr">
        <div class="fg">
          <label>Confirmar e-mail *</label>
          <input type="email" id="em2" placeholder="seuemail@exemplo.com">
        </div>
      </div>
      <div class="fr">
        <div class="fg">
          <label>CPF *</label>
          <input type="text" placeholder="000.000.000-00" maxlength="14" oninput="fmtCPF(this)">
        </div>
        <div class="fg">
          <label>Celular *</label>
          <input type="text" placeholder="(00) 00000-0000" maxlength="15" oninput="fmtTel(this)">
        </div>
      </div>
    </div>
  </div>

  <!-- PIX PAYMENT (inicialmente oculto) -->
  <div class="block" id="pixBlock" style="display:none;">
    <div class="sec-head">
      <!-- pix icon (official diamond shape, crisp) -->
      <svg width="15" height="15" viewBox="0 0 32 32" fill="none">
        <path d="M11.06 7.06a5 5 0 0 1 7.07 0l.7.71L21 5.66a7 7 0 0 0-9.9 0L8.99 7.77l2.07 2.07zM7.06 11.06 4.95 8.95A7 7 0 0 0 4.95 18.9l2.11-2.11a5 5 0 0 1 0-5.73zM18.13 25.8a7 7 0 0 1-4.26 0l-2.07 2.07a9.96 9.96 0 0 0 8.4 0zM25.8 13.87a9.96 9.96 0 0 1 0 8.4l-2.07-2.07a7 7 0 0 0 0-4.26z" fill="#32BCAD"/>
        <path d="M22.63 9.37a9 9 0 1 0 0 12.73L29 16z" fill="#32BCAD" opacity=".25"/>
        <path d="M19.78 12.22a4 4 0 0 0-5.66 0L9.37 16.97a1 1 0 0 0 0 1.41l.71.71a4 4 0 0 0 5.66 0l2.83-2.83 2.83 2.83a4 4 0 0 0 5.66 0l.71-.71a1 1 0 0 0 0-1.41z" fill="#32BCAD"/>
      </svg>
      Pagamento via Pix
    </div>

    <div class="pix-hero">
      <!-- PIX logo pill -->
      <div class="pix-logo-wrap">
        <!-- official pix SVG logo shape -->
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="8" fill="#32BCAD"/>
          <path d="M18 7l-5.25 5.25a1.5 1.5 0 0 0 0 2.12L18 19.62l5.25-5.25a1.5 1.5 0 0 0 0-2.12zm0 12.75-5.25 5.25a1.5 1.5 0 0 0 0 2.12L18 32.37l5.25-5.25a1.5 1.5 0 0 0 0-2.12zM7 18l5.25-5.25a1.5 1.5 0 0 1 2.12 0L18 17l-4.62 4.62a1.5 1.5 0 0 1-2.12 0zm22 0-5.25 5.25a1.5 1.5 0 0 1-2.12 0L18 19l4.62-4.62a1.5 1.5 0 0 1 2.12 0z" fill="white"/>
        </svg>
